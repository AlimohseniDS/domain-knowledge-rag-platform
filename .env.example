APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

POSTGRES_DB=rag_platform
POSTGRES_USER=rag_app
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+asyncpg://rag_app:change-me@postgres:5432/rag_platform

REDIS_URL=redis://redis:6379/0

STORAGE_BACKEND=filesystem
LOCAL_STORAGE_PATH=/app/data/documents

LLM_PROVIDER=openai_compatible
LLM_BASE_URL=http://llm:8000/v1
LLM_API_KEY=local-vllm
LLM_MODEL=Qwen/Qwen3.5-35B-A3B-GPTQ-Int4

# Single NVIDIA RTX A6000 (48 GB) serving defaults
VLLM_MAX_MODEL_LEN=32768
VLLM_GPU_MEMORY_UTILIZATION=0.90
VLLM_QUANTIZATION=moe_wna16
VLLM_REASONING_PARSER=qwen3
VLLM_LANGUAGE_MODEL_ONLY=true

# Optional commercial provider credentials belong in .env, never in Git.
# COMMERCIAL_LLM_API_KEY=

# Optional MinIO/S3-compatible storage profile
# S3_ENDPOINT=http://minio:9000
# S3_BUCKET=rag-documents
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=change-me
# S3_USE_SSL=false
